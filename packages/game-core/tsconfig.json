{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "../../src/game-core",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "../../src/game-core/**/*.ts"
  ],
  "exclude": [
    "../../src/game-core/**/*.test.ts",
    "../../src/game-core/**/*.test.tsx"
  ]
}
